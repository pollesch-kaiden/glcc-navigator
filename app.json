{
  "expo": {
    "name": "GLCC Navigator",
    "slug": "glcc-navigator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon-mark-green.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/icon-mark-green.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a4a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaidenpollesch.glcc-navigator",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GLCC Navigator uses your location to show where you are on the campus map and provide turn-by-turn directions.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "api.protomaps.com": {
              "NSExceptionRequiresForwardSecrecy": false,
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a4a2e",
        "foregroundImage": "./assets/branding/icon-mark-green.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kaidenpollesch.glccnavigator"
    },
    "web": {
      "favicon": "./assets/branding/icon-mark-green.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "e1fdb7db-687a-4fe9-bbb3-be1907139c6d"
      }
    }
  }
}
